# Copy to .env (or export these in your shell). All are optional.

# Where the hub keeps its database (hub.db) and the boss token file.
HUB_HOME=~/.familyhub

# Port for the web page and the API.
HUB_PORT=8770

# 127.0.0.1 = only this Mac can connect (safest).
# 0.0.0.0   = other devices on your home Wi-Fi (phone, Raspberry Pi, ESP32) can connect.
HUB_HOST=127.0.0.1

# Set to 1 to print every HTTP request in the terminal.
HUB_DEBUG=0
